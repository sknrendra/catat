# Copy this file to .env and fill in real values before running
# `docker compose up`.

# --- BetterAuth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the app is served at. Leave as https://localhost for local use
# with the bundled Caddy reverse proxy; set to your real domain in production.
BETTER_AUTH_URL=https://localhost

# --- Caddy ---
# Domain Caddy should request a certificate for. Leave as "localhost" for a
# locally-trusted self-signed certificate; set to a real domain (e.g.
# notes.example.com) to get a real Let's Encrypt certificate instead.
SITE_ADDRESS=localhost

# --- MinIO (object storage for note attachments) ---
MINIO_ROOT_USER=catat
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-password
MINIO_BUCKET=catat-attachments

# --- Resend (email verification on sign up) ---
# Get an API key at https://resend.com/api-keys, and verify a sending
# domain/subdomain at https://resend.com/domains (a subdomain like
# catat.example.com works fine and won't affect your root domain's mail).
RESEND_API_KEY=
EMAIL_FROM=Catat <noreply@catat.example.com>

# --- OAuth providers (optional) ---
# Uncomment and fill in to enable social sign-in in addition to email/password.
# Add the matching provider block to lib/auth.ts's socialProviders option.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
